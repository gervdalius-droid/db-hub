# worxmax.com on Hostinger. The whole repository is deployed into public_html,
# so keep everything that is not part of the website out of reach.
Options -Indexes
DirectoryIndex index.html

# Always HTTPS, and worxmax.com without www.
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://worxmax.com%{REQUEST_URI} [R=301,L]

# Not for visitors: git data, design notes, server code, screenshot origin notes.
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule ^(supabase|\.impeccable)(/|$) - [F,L]
RewriteRule \.(md|ts|sql|yml|bundle|py)$ - [F,L]
RewriteRule ^assets/apps/.*\.json$ - [F,L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(woff2|webp|png|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
