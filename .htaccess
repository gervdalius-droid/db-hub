# worxmax.com on Hostinger. The whole repository is deployed into public_html,
# so keep everything that is not part of the website out of reach.
Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# Two addresses share this folder:
#   worxmax.com      the website (index, apps, privacy)
#   app.worxmax.com  the product (dashboard at /, the nine apps, admin)

# --- app.worxmax.com ---------------------------------------------------------
RewriteCond %{HTTP_HOST} ^app\.worxmax\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://app.worxmax.com%{REQUEST_URI} [R=301,L]
# old /app/ address → the root (keeps ?next=… and the rest)
RewriteCond %{HTTP_HOST} ^app\.worxmax\.com$ [NC]
RewriteCond %{THE_REQUEST} \s/app/?(index\.html)?[\s?]
RewriteRule ^app/?(index\.html)?$ / [R=301,L]
# website pages live on worxmax.com
RewriteCond %{HTTP_HOST} ^app\.worxmax\.com$ [NC]
RewriteRule ^(index\.html|apps\.html|privacy\.html)$ https://worxmax.com/$1 [R=301,L]
# the dashboard is the home page here
RewriteCond %{HTTP_HOST} ^app\.worxmax\.com$ [NC]
RewriteRule ^$ app/index.html [L]

# --- worxmax.com (and www) ---------------------------------------------------
RewriteCond %{HTTP_HOST} !^app\.worxmax\.com$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://worxmax.com%{REQUEST_URI} [R=301,L]
# the product moved to app.worxmax.com: old links keep working
RewriteCond %{HTTP_HOST} !^app\.worxmax\.com$ [NC]
RewriteRule ^app/?(index\.html)?$ https://app.worxmax.com/ [R=301,L]
RewriteCond %{HTTP_HOST} !^app\.worxmax\.com$ [NC]
RewriteRule ^((offer|builder|cad|nesting|shopflow-app|hub|invoices|admin)(/.*)?|leads\.html)$ https://app.worxmax.com/$1 [R=301,L]

# Not for visitors: git data, design notes, server code, screenshot origin notes.
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule ^(supabase|\.impeccable)(/|$) - [F,L]
RewriteRule \.(md|ts|sql|yml|bundle|py)$ - [F,L]
RewriteRule ^assets/apps/.*\.json$ - [F,L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(woff2|webp|png|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
